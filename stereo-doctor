#!/bin/bash
# Checks the things that fail silently. Both macOS permissions this depends on
# report success and then do nothing — the tap returns digital silence, and the
# remote client's connections are dropped with a misleading "No route to host".
# Neither shows an error, so check them directly rather than trusting a log.
cd "$(dirname "$0")"
source ./config.sh

pass() { printf "  \033[32mok\033[0m    %s\n" "$1"; }
warn() { printf "  \033[33mwarn\033[0m  %s\n" "$1"; }
bad()  { printf "  \033[31mFAIL\033[0m  %s\n" "$1"; FAILED=1; }
FAILED=0

echo "prerequisites"
command -v swiftc >/dev/null && pass "swift toolchain" || bad "swiftc missing — install Xcode or the command line tools"
[ -d bin/StereoPair.app ] && pass "StereoPair.app built" || bad "not built — run ./build.sh"
[ -d bin/StereoMenu.app ] && pass "StereoMenu.app built" || bad "not built — run ./build.sh"

echo
echo "second Mac"
# No ssh here on purpose: once deployed, the receiver is a login item and is
# found over Bonjour, so this checks what actually matters at run time.
FOUND=$(bin/StereoPair.app/Contents/MacOS/stereopair --list 2>&1 | grep -v "no receivers" | head -1)
if [ -n "$FOUND" ]; then
	pass "receiver found: $FOUND"
else
	bad "no receiver on the network — run ./deploy-peer.sh, or check that the"
	echo "        other Mac is awake and StereoPair is allowed under Privacy &"
	echo "        Security > Local Network there"
fi

echo
echo "system audio recording permission (this Mac)"
# Creating a tap succeeds even when permission is denied; it just yields
# silence. So capture a real tone and look at it.
if [ -d bin/StereoPair.app ] && command -v ffmpeg >/dev/null; then
	TMP=$(mktemp -d)
	ffmpeg -hide_banner -loglevel error -f lavfi -i "sine=f=440:r=48000:d=2" \
		-af "volume=0.08" -ac 2 -y "$TMP/probe.wav" 2>/dev/null
	# `open` so the tap runs under the app's own identity, and a file for the
	# result because `open` detaches from this shell.
	open -n bin/StereoPair.app --args --selftest --log "$TMP/tap.log" 2>/dev/null
	sleep 1
	afplay "$TMP/probe.wav" 2>/dev/null
	sleep 2
	# A denied tap returns exact zeros, so anything clearly above the noise
	# floor is a pass. The absolute level is not meaningful: the tap captures
	# after the system volume, so a quiet Mac yields a small peak.
	PEAK=$(grep -aoE "captured peak [0-9]+" "$TMP/tap.log" | tail -1 | awk '{print ($3 > 20) ? "yes" : "no"}')
	if [ "$PEAK" = "yes" ]; then
		pass "tap captures audio"
	else
		bad "tap returns silence — allow StereoPair under System Settings >"
		echo "        Privacy & Security > Screen & System Audio Recording."
		echo "        Launch it with 'open', never a bare binary: the permission is"
		echo "        charged to whichever app started the process."
	fi
	rm -rf "$TMP"
else
	warn "skipped (needs ffmpeg: brew install ffmpeg)"
fi

echo
echo "local network permission (this Mac)"
if true; then
	LOG=$(cat run/stereopair.log 2>/dev/null)
	if echo "$LOG" | grep -q "No route to host"; then
		bad "connections are being blocked — allow StereoPair under System Settings >"
		echo "        Privacy & Security > Local Network on this Mac."
		echo "        'No route to host' here means policy, not networking: ping and"
		echo "        nc to the same port will succeed."
	elif echo "$LOG" | grep -q "tapping"; then
		pass "sender connected to the second Mac"
	else
		warn "no history yet — run ./stereo-start, then re-run this"
	fi
fi


echo
[ "$FAILED" = 0 ] && echo "all good." || echo "fix the FAIL lines above, then re-run."
exit "$FAILED"
