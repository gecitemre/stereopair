#!/bin/bash
cd "$(dirname "$0")"
source ./config.sh

RUN="$PWD/run"

# Stop the tap first so apps stop being muted even if the rest hangs.
pkill -f 'StereoTap.app/Contents/MacOS/stereotap' 2>/dev/null

for name in volume snapclient snapserver; do
	if [ -f "$RUN/$name.pid" ]; then
		kill "$(cat "$RUN/$name.pid")" 2>/dev/null
		rm -f "$RUN/$name.pid"
	fi
done

ssh -o BatchMode=yes -o ConnectTimeout=5 "$PEER" \
	"pkill -f 'SnapRight[.]app/Contents/MacOS/snapclient'" 2>/dev/null

rm -f "$RUN/left" "$RUN/right"
echo "stereo stopped"
