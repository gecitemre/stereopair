#!/bin/bash
# No ssh, no addresses, no link detection: the receiver runs at login on the
# other Mac and advertises itself, and the sender finds it, picks the best of
# the addresses it advertises, and tells it what target to hold.
set -euo pipefail
cd "$(dirname "$0")"
source ./config.sh

RUN="$PWD/run"
mkdir -p "$RUN"

pkill -f 'StereoPair[.]app/Contents/MacOS/stereopair' 2>/dev/null || true
sleep 1

start_sender() {
	rm -f "$RUN/stereopair.log"
	# `open` rather than the binary directly: the audio tap's permission is
	# granted to whichever app launches the process, so a bare binary gets
	# silence with no error.
	open -n bin/StereoPair.app --args --send auto \
		--target-ms "$TARGET_MS" --io-frames "$IO_FRAMES" --log "$RUN/stereopair.log"
	# Poll rather than sleep a fixed amount: finding the receiver and creating
	# the tap take a few seconds, and a short fixed wait reports a working start
	# as a failure.
	for _ in $(seq 1 30); do
		grep -q "tapping" "$RUN/stereopair.log" 2>/dev/null && return 0
		grep -q "No route to host" "$RUN/stereopair.log" 2>/dev/null && return 1
		sleep 0.5
	done
	return 1
}

# Rebuilding changes the ad-hoc signature, which macOS treats as a new identity:
# the first connection after a build is refused while it re-registers, and the
# next one succeeds. Retry once rather than making that the user's problem.
if ! start_sender; then
	if grep -q "No route to host" "$RUN/stereopair.log" 2>/dev/null; then
		pkill -f 'StereoPair[.]app/Contents/MacOS/stereopair' 2>/dev/null
		sleep 1
		start_sender || true
	fi
fi

if ! grep -q "tapping" "$RUN/stereopair.log" 2>/dev/null; then
	echo "stereo: could not start —"
	sed 's/^/  /' "$RUN/stereopair.log" 2>/dev/null
	echo "  is StereoPair running on the other Mac? ./deploy-peer.sh installs it."
	exit 1
fi

# `open` does not report the pid it launched, and the menu bar app needs
# something to test.
pgrep -f 'StereoPair[.]app/Contents/MacOS/stereopair' > "$RUN/stereopair.pid"

echo
grep -a "connected to" "$RUN/stereopair.log" | sed 's/stereopair: /stereo is up: /'
echo "  left  = this Mac, right = the Mac it found"
echo "  stop with    ./stereo-stop"
