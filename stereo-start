#!/bin/bash
set -euo pipefail
cd "$(dirname "$0")"
source ./config.sh

RUN="$PWD/run"
mkdir -p "$RUN"

./stereo-stop >/dev/null 2>&1 || true

# Prefer a direct Thunderbolt cable when one is actually usable, otherwise fall
# back to Wi-Fi. Both machines must have an address on the bridge and be able to
# reach each other over it: bridge0 exists and stays UP with no cable attached,
# so its presence alone proves nothing.
resolve_link() {
	if [ "$IFACE" != auto ]; then
		LINK="$IFACE"
		LOCAL_IP=$(ipconfig getifaddr "$IFACE" || true)
		[ -n "$LOCAL_IP" ] || { echo "stereo: no address on $IFACE"; exit 1; }
		PEER_IP=$(ssh -o BatchMode=yes -o ConnectTimeout=5 "$PEER" \
			"ipconfig getifaddr $IFACE" 2>/dev/null || true)
		[ -n "$PEER_IP" ] || { echo "stereo: peer has no address on $IFACE"; exit 1; }
		return
	fi

	local bridge_ip peer_bridge
	bridge_ip=$(ipconfig getifaddr bridge0 2>/dev/null || true)
	if [ -n "$bridge_ip" ]; then
		peer_bridge=$(ssh -o BatchMode=yes -o ConnectTimeout=5 "$PEER" \
			'ipconfig getifaddr bridge0' 2>/dev/null || true)
		if [ -n "$peer_bridge" ] && ping -c 1 -t 1 "$peer_bridge" >/dev/null 2>&1; then
			LINK="thunderbolt"
			LOCAL_IP="$bridge_ip"
			PEER_IP="$peer_bridge"
			return
		fi
	fi

	LINK="wi-fi"
	LOCAL_IP=$(ipconfig getifaddr en0 || true)
	PEER_IP=$(ssh -o BatchMode=yes -o ConnectTimeout=5 "$PEER" \
		'ipconfig getifaddr en0' 2>/dev/null || true)
	[ -n "$PEER_IP" ] || { echo "stereo: cannot reach the second Mac"; exit 1; }
}

resolve_link

# A target tuned for the cable cannot hold over Wi-Fi, so it follows the link
# unless you pinned it yourself.
if [ "$TARGET_MS" = auto ]; then
	if [ "$LINK" = thunderbolt ]; then TARGET_MS="$TARGET_WIRED"; else TARGET_MS="$TARGET_WIRELESS"; fi
fi

# Receiver first: the sender exits if nothing is listening.
ssh -o BatchMode=yes "$PEER" \
	"pkill -f 'StereoPair[.]app'; sleep 1; \
	 rm -f ~/stereopair/recv.log; \
	 open -n ~/stereopair/StereoPair.app --args --recv \
	   --target-ms $TARGET_MS --io-frames $IO_FRAMES --log \$HOME/stereopair/recv.log"

sleep 2

# `open` rather than the binary directly: the audio tap's permission is granted
# to whichever app launches the process, so a bare binary gets silence.
start_sender() {
	rm -f "$RUN/stereopair.log"
	open -n bin/StereoPair.app --args --send "$PEER_IP" \
		--target-ms "$TARGET_MS" --io-frames "$IO_FRAMES" --log "$RUN/stereopair.log"
	# Poll rather than sleep a fixed amount: creating the tap can take several
	# seconds, and a short fixed wait reports a working start as a failure.
	for _ in $(seq 1 20); do
		grep -q "tapping" "$RUN/stereopair.log" 2>/dev/null && return 0
		grep -q "No route to host" "$RUN/stereopair.log" 2>/dev/null && return 1
		sleep 0.5
	done
	return 1
}

# Rebuilding changes the ad-hoc signature, which macOS treats as a new identity:
# the first connection after a build is refused while it re-registers, and the
# next one succeeds. Retry once rather than making that the user's problem.
if ! start_sender; then
	if grep -q "No route to host" "$RUN/stereopair.log" 2>/dev/null; then
		pkill -f 'StereoPair[.]app/Contents/MacOS/stereopair' 2>/dev/null
		sleep 1
		start_sender || true
	fi
fi

if ! grep -q "tapping" "$RUN/stereopair.log" 2>/dev/null; then
	echo "stereo: sender did not start —"
	sed 's/^/  /' "$RUN/stereopair.log" 2>/dev/null
	exit 1
fi

# `open` does not report the pid it launched, and the menu bar app needs
# something to test.
pgrep -f 'StereoPair[.]app/Contents/MacOS/stereopair' > "$RUN/stereopair.pid"

if [ "$SYNC_VOLUME" = 1 ]; then
	./stereo-volume-sync start
fi

echo
echo "stereo is up over $LINK, ${TARGET_MS}ms target"
echo "  left  = this Mac"
echo "  right = $PEER"
echo "  stop with    ./stereo-stop"
